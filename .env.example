# ==============================================================================
# Company OCR Service - Environment Configuration Example
# ==============================================================================

# AI Mode Configuration (OpenRouter, OpenAI, or Gemini)
# Leave blank or configure with your provider API key.
AI_PROVIDER=openrouter
AI_API_KEY=your_openrouter_api_key_here
AI_MODEL=google/gemini-2.5-flash
AI_BASE_URL=https://openrouter.ai/api/v1

# OCR Engine Configuration ('auto', 'rapidocr', 'paddleocr')
OCR_ENGINE=auto

# Security & Authentication Configuration ('disabled', 'jwt', 'api_key', 'dual')
AUTH_ENABLED=false
AUTH_MODE=disabled
# JWT_SECRET=your-secure-32-character-production-secret
# API_KEY=your-static-api-key-for-internal-services
# REGISTERED_CLIENTS_JSON={"client-app-id": "client-secure-secret"}

# Temporary and Document Storage Directories
# OCR_TEMP_DIR=/tmp/company_ocr_temp
# DOCUMENT_STORAGE_DIR=uploads
# TEMP_FILE_TTL_MINUTES=15

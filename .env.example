# ==============================================================================
# Company Server OCR - Production Environment Configuration Template
# ==============================================================================

# Application Environment (production | development | test)
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# Authentication Configuration (disabled | apikey | jwt | dual)
AUTH_ENABLED=false
AUTH_MODE=disabled

# Server-Side Document Encryption (AES-256-GCM)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
DOCUMENT_ENCRYPTION_KEY=64_character_hex_encoded_aes_256_key

# Automatic Document Retention & Lifecycle Cleanup (Phase 6)
# Default: 30 days. Set to 0 to disable automatic deletion.
DOCUMENT_RETENTION_DAYS=30
# Background cleanup check interval in hours (default: 24)
CLEANUP_INTERVAL_HOURS=24

# Local Ollama AI Mode Configuration (Air-Gapped / Private Network)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5vl:3b

# Storage & Upload Protections
MAX_IMAGE_SIZE_MB=20
MAX_PDF_SIZE_MB=50

# CORS Allowed Origins (comma-separated list for production)
CORS_ALLOWED_ORIGINS=http://localhost,https://localhost

# Backend Rate Limiting (Requests per minute per client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_UPLOAD_PER_MINUTE=60
RATE_LIMIT_AI_CHAT_PER_MINUTE=30
RATE_LIMIT_CLEANUP_PER_MINUTE=10
